{
  // MCP（Model Context Protocol）服务器配置
  // 此文件定义了 Squad 可以连接的外部 MCP 服务器
  // 每个服务器都是一个独立的进程，通过 stdio 与 Squad 通信
  "mcpServers": {
    // 示例：Trello MCP 服务器配置
    // 这是一个示例配置，展示了如何添加 MCP 服务器
    "EXAMPLE-trello": {
      // 启动服务器的命令
      "command": "npx",
      // 传递给命令的参数
      "args": [
        "-y",                    // 自动同意安装
        "@trello/mcp-server"     // Trello MCP 服务器包名
      ],
      // 环境变量配置
      "env": {
        // Trello API 密钥，使用 ${} 语法引用环境变量
        "TRELLO_API_KEY": "${TRELLO_API_KEY}",
        // Trello 访问令牌，使用 ${} 语法引用环境变量
        "TRELLO_TOKEN": "${TRELLO_TOKEN}"
      }
    }
  }
}
